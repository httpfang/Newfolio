# REQUIRED for private + org contribution squares (to match github.com graph)
# Use a CLASSIC Personal Access Token (not fine-grained / github_pat_*)
#
# Create: https://github.com/settings/tokens
#   1. Generate new token (classic)
#   2. Scope: check ONLY "read:user"
#   3. Generate, then paste below
#
# Restart after changing: stop and run `npm run dev` again
VITE_GITHUB_TOKEN=ghp_your_classic_token_here
